# LabLink Environment Configuration Template
# Academic Laboratory Resource Sharing Platform (PromptWars 2026)

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lablink

# Runtime Environment (development | production | test)
NODE_ENV=development

# Evaluator Demonstration Authentication
# When true AND NODE_ENV !== "production", enables instant one-click demo login
# In production, demo logins are strictly locked out and will fail closed
ENABLE_LOCAL_DEMO_AUTH=true

# Firebase Authentication (Evaluator Demonstration Credentials)
FIREBASE_PROJECT_ID=lablink-demo-2026
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoFakeApiKeyForEvaluation2026
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lablink-demo-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lablink-demo-2026

# Optional: Google Gemini API Key for Natural Language Scheduling Queries
GEMINI_API_KEY=
